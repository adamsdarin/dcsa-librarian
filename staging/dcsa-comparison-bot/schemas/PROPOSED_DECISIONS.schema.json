{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dcsa-comparison-bot/proposed-decisions/1.0",
  "title": "Proposed lifecycle decisions and guidance-catalog handoff",
  "description": "Nothing in this file has been applied. archivist_metadata_decisions conforms to dcsa-library/metadata-decisions/1.0 so the DCSA Archivist can consume it after human review.",
  "type": "object",
  "required": [
    "schema_version", "proposal_state", "generated_at", "generated_by", "reviewer",
    "counts", "archivist_metadata_decisions", "blocked", "skipped", "fso_guidance_watch_handoff"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "proposal_state": {"const": "proposed_not_applied"},
    "generated_at": {"type": "string", "format": "date-time"},
    "generated_by": {"const": "dcsa-comparison-bot"},
    "reviewer": {"type": "string", "minLength": 1, "description": "The named human who will own the decision. The bot never signs as itself."},
    "include_inferred": {"type": "boolean"},
    "counts": {"type": "object"},
    "archivist_metadata_decisions": {
      "type": "object",
      "required": ["schema_version", "decisions"],
      "properties": {
        "schema_version": {"const": "1.0"},
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "source_document_id", "robot_text_path", "decision", "verified_utc",
              "verified_by", "evidence", "note", "requires_official_lifecycle_evidence"
            ],
            "properties": {
              "decision": {"enum": ["verified_current", "superseded", "historical", "exclude"]},
              "robot_text_path": {"type": "string", "pattern": "^ROBOT_READABLE_DIRECTORY/"},
              "evidence": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "required": ["url"],
                  "properties": {
                    "url": {"type": "string", "pattern": "^https://"},
                    "evidence_type": {"enum": ["candidate_location_only", "official_lifecycle_evidence"]}
                  },
                  "additionalProperties": true
                }
              },
              "requires_official_lifecycle_evidence": {"const": true},
              "proposal_basis": {"enum": ["deterministic", "inferred"]}
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": false
    },
    "blocked": {"type": "array", "items": {"type": "object"}},
    "skipped": {"type": "array", "items": {"type": "object"}},
    "fso_guidance_watch_handoff": {"type": "array", "items": {"type": "object"}},
    "schema_problems": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
