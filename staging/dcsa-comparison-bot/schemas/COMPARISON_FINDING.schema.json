{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dcsa-comparison-bot/comparison-finding/1.0",
  "title": "One proposed pairing between a candidate document and a library document",
  "description": "A finding is a proposal for human review. It never asserts that a document is superseded, current, or applicable.",
  "type": "object",
  "required": [
    "finding_id", "candidate_id", "candidate_title", "incumbent_document_id",
    "relationship", "basis", "signals", "content_comparison", "disposition", "recommended_next_action"
  ],
  "properties": {
    "finding_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "candidate_title": {"type": "string"},
    "candidate_source_uri": {"type": ["string", "null"]},
    "candidate_source_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "incumbent_document_id": {"type": "string", "minLength": 1},
    "incumbent_title": {"type": "string"},
    "incumbent_robot_text_path": {"type": ["string", "null"]},
    "incumbent_current_status": {"type": ["string", "null"]},
    "incumbent_authority_role": {"type": ["string", "null"]},
    "relationship": {
      "enum": [
        "identical", "identical_after_normalization", "newer_edition_candidate",
        "older_edition_candidate", "same_edition_candidate", "edition_undetermined",
        "title_similar", "no_match"
      ]
    },
    "basis": {
      "enum": ["deterministic", "inferred"],
      "description": "deterministic: reproducible from observable tokens or hashes. inferred: a similarity judgement."
    },
    "signals": {
      "type": "object",
      "required": ["match_route"],
      "properties": {
        "match_route": {"enum": ["document_number", "series_key", "title_similarity"]},
        "shared_document_numbers": {"type": "array", "items": {"type": "string"}},
        "edition_order": {
          "type": "object",
          "properties": {
            "order": {"type": ["integer", "null"], "enum": [-1, 0, 1, null]},
            "kind": {"type": ["string", "null"]}
          },
          "additionalProperties": true
        },
        "title_similarity": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": true
    },
    "content_comparison": {
      "enum": ["available", "unavailable_no_candidate_text", "unavailable_no_incumbent_text"]
    },
    "disposition": {"const": "proposed_for_human_review"},
    "recommended_next_action": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
