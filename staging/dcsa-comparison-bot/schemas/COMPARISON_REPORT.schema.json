{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dcsa-comparison-bot/comparison-report/1.0",
  "title": "Comparison run report",
  "type": "object",
  "required": [
    "schema_version", "generated_at", "publication_performed", "decisions_written",
    "baseline", "settings", "counts", "findings", "unmatched", "suppressed_routes"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "generated_at": {"type": "string", "format": "date-time"},
    "publication_performed": {"const": false},
    "decisions_written": {"const": false},
    "baseline": {"type": "object"},
    "settings": {
      "type": "object",
      "properties": {
        "title_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "max_matches": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "counts": {"type": "object"},
    "findings": {"type": "array", "items": {"$ref": "dcsa-comparison-bot/comparison-finding/1.0"}},
    "unmatched": {"type": "array", "items": {"type": "object"}},
    "suppressed_routes": {
      "type": "array",
      "description": "Pairing routes deliberately not taken, with the reason. Recorded so a reviewer can see what the bot chose not to look at.",
      "items": {"type": "object"}
    }
  },
  "additionalProperties": false
}
